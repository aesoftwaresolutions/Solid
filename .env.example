# Copy to .env and fill in. Never commit .env.
SOLID_DB_PASSWORD=change-me
# 32 random bytes, base64:  openssl rand -base64 32
# (PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 })))
# Keep a copy somewhere safe: without this key the encrypted fields and uploaded
# documents cannot be read, and there is no recovery.
SOLID_MASTER_KEY=

# Optional: only needed if this machine's default ports are already taken by something else, or you're also
# running the serverless desktop instance (docker-compose.yml's "desktop" service, spec 066) alongside the
# server, pointed at this same database over a network other machines can reach it on (e.g. Tailscale).
#SOLID_WEB_PORT=8080
#SOLID_DB_EXPOSED_BIND=127.0.0.1
#SOLID_DB_EXPOSED_PORT=5432
#SOLID_DESKTOP_DATA_DIR=./data/desktop
#SOLID_DESKTOP_PORT=18081
#SOLID_DESKTOP_UID=1000
#SOLID_DESKTOP_GID=1000

# Optional: category suggestions from a model running on this same server (Ollama).
# Off by default. Only a bank description, its amount and your account codes are sent, and the answer can only
# pick from those accounts. No tax figure ever comes from a model.
#SOLID_AI_ENABLED=true
#SOLID_AI_BASE_URL=http://localhost:11434
#SOLID_AI_MODEL=llama3.2
